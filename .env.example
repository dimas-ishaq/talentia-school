# Required: minimal 32 karakter acak. Contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters

# Database produksi (PostgreSQL). Jika dikosongkan, aplikasi memakai SQLite.
DATABASE_URL=postgresql://postgres:change-me@db:5432/school_app
POSTGRES_PASSWORD=change-me
# SQLITE_PATH=./server/database/local.db

# Port host untuk aplikasi (docker compose)
APP_PORT=3000

# Biarkan false di produksi agar akun demo tidak ditampilkan di halaman login
NUXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false

# Email reset password (opsional; tanpa ini token hanya ditulis ke log server)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_APP_URL=http://localhost:3000

# Backup
BACKUP_DIR=./backups
